# AegisPay Environment Configuration Template
# NOTE: Zero-Config Mode is enabled by default! The project runs out of the box
# with high-fidelity offline fallbacks without requiring any external API credentials.

# PayPal Sandbox Developer Credentials (Optional - Mock Sandbox runs if left empty)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# OpenAI API Configuration (Optional - Offline Two-Pass Evaluator runs if left empty)
OPENAI_API_KEY=your_openai_api_key_here
